{% comment %}
  Product info tabs — groups below-the-buy-box content into a horizontal tab menu.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign fb = product
  if fb == blank
    assign fb = all_products['flexbrace-afo']
    if fb == blank
      assign fb = all_products['afo-ortos-ankel-fotortos']
    endif
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="flexbrace-tabs" data-flexbrace-tabs>
    <div class="flexbrace-tabs__nav-wrap">
      <div
        class="flexbrace-tabs__nav"
        role="tablist"
        aria-label="{{ 'flexbrace.product.tabs.label' | t | escape }}"
      >
        <button
          type="button"
          class="flexbrace-tabs__tab is-active"
          role="tab"
          id="fb-tab-overview"
          aria-selected="true"
          aria-controls="fb-panel-overview"
          data-tab="overview"
        >
          {{ 'flexbrace.product.tabs.overview' | t }}
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-specs"
          aria-selected="false"
          aria-controls="fb-panel-specs"
          data-tab="specs"
          tabindex="-1"
        >
          {{ 'flexbrace.product.tabs.specs' | t }}
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-delivery"
          aria-selected="false"
          aria-controls="fb-panel-delivery"
          data-tab="delivery"
          tabindex="-1"
        >
          {{ 'flexbrace.product.tabs.delivery' | t }}
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-faq"
          aria-selected="false"
          aria-controls="fb-panel-faq"
          data-tab="faq"
          tabindex="-1"
        >
          {{ 'flexbrace.product.tabs.faq' | t }}
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-about"
          aria-selected="false"
          aria-controls="fb-panel-about"
          data-tab="about"
          tabindex="-1"
        >
          {{ 'flexbrace.product.tabs.about' | t }}
        </button>
      </div>
    </div>

    <div class="flexbrace-tabs__panels">
      {%- comment -%} Översikt {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel is-active"
        role="tabpanel"
        id="fb-panel-overview"
        aria-labelledby="fb-tab-overview"
        data-panel="overview"
      >
        <div class="flexbrace-product-section flexbrace-product-overview">
          <div class="flexbrace-product-section__header">
            <h2>{{ 'flexbrace.product.overview.heading' | t }}</h2>
            <p>{{ 'flexbrace.product.overview.intro' | t }}</p>
          </div>

          <p class="flexbrace-product-overview__body">{{ 'flexbrace.product.overview.body' | t }}</p>

          <div class="flexbrace-product-overview__block">
            <h3>{{ 'flexbrace.product.overview.does.heading' | t }}</h3>
            <p>{{ 'flexbrace.product.overview.does.intro' | t }}</p>
            <ul class="flexbrace-checklist">
              <li>{{ 'flexbrace.product.overview.does.1' | t }}</li>
              <li>{{ 'flexbrace.product.overview.does.2' | t }}</li>
              <li>{{ 'flexbrace.product.overview.does.3' | t }}</li>
              <li>{{ 'flexbrace.product.overview.does.4' | t }}</li>
              <li>{{ 'flexbrace.product.overview.does.5' | t }}</li>
            </ul>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>{{ 'flexbrace.product.overview.design.heading' | t }}</h3>
            <p>{{ 'flexbrace.product.overview.design.intro' | t }}</p>
            <ul class="flexbrace-checklist">
              <li>{{ 'flexbrace.product.overview.design.1' | t }}</li>
              <li>{{ 'flexbrace.product.overview.design.2' | t }}</li>
              <li>{{ 'flexbrace.product.overview.design.3' | t }}</li>
              <li>{{ 'flexbrace.product.overview.design.4' | t }}</li>
            </ul>
            <p class="flexbrace-product-overview__body">{{ 'flexbrace.product.overview.design.closing' | t }}</p>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>{{ 'flexbrace.product.overview.manufacturing.heading' | t }}</h3>
            <p>{{ 'flexbrace.product.overview.manufacturing.body' | t }}</p>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>{{ 'flexbrace.product.overview.for_whom.heading' | t }}</h3>
            <p>{{ 'flexbrace.product.overview.for_whom.body' | t }}</p>
          </div>
        </div>
      </div>

      {%- comment -%} Specifikation {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-specs"
        aria-labelledby="fb-tab-specs"
        data-panel="specs"
        hidden
      >
        <div class="flexbrace-product-section flexbrace-product-section--surface">
          <div class="flexbrace-product-section__header">
            <p class="product-page-eyebrow">{{ 'flexbrace.product.specs.eyebrow' | t }}</p>
            <h2>{{ 'flexbrace.product.specs.heading' | t }}</h2>
            <p>{{ 'flexbrace.product.specs.lead' | t }}</p>
          </div>
          <div class="flexbrace-product-specs-grid">
            <div class="flexbrace-product-specs">
              <p class="flexbrace-product-specs__heading">{{ 'flexbrace.product.specs.spec_heading' | t }}</p>
              <dl>
                <div>
                  <dt>{{ 'flexbrace.product.specs.weight' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.weight_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.type' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.type_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.comfort' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.comfort_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.shoes' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.shoes_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.variant' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.variant_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.size' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.size_value' | t }}</dd>
                </div>
              </dl>
            </div>
            <div class="flexbrace-product-specs">
              <p class="flexbrace-product-specs__heading">{{ 'flexbrace.product.specs.guide_heading' | t }}</p>
              <dl>
                <div>
                  <dt>{{ 'flexbrace.product.specs.fit' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.fit_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.eu' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.eu_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.us_men' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.us_men_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.us_women' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.us_women_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.uk' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.uk_value' | t }}</dd>
                </div>
                <div>
                  <dt>{{ 'flexbrace.product.specs.cm' | t }}</dt>
                  <dd>{{ 'flexbrace.product.specs.cm_value' | t }}</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Leverans {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-delivery"
        aria-labelledby="fb-tab-delivery"
        data-panel="delivery"
        hidden
      >
        <div class="flexbrace-product-section flexbrace-product-section--surface">
          <div class="flexbrace-product-section__header">
            <p class="product-page-eyebrow">{{ 'flexbrace.product.delivery.eyebrow' | t }}</p>
            <h2>{{ 'flexbrace.product.delivery.heading' | t }}</h2>
            <p>{{ 'flexbrace.product.delivery.lead' | t }}</p>
          </div>
          <div class="flexbrace-product-specs">
            <dl>
              <div>
                <dt>{{ 'flexbrace.product.delivery.shipping' | t }}</dt>
                <dd>{{ 'flexbrace.product.delivery.shipping_value' | t }}</dd>
              </div>
              <div>
                <dt>{{ 'flexbrace.product.delivery.time' | t }}</dt>
                <dd>{{ 'flexbrace.product.delivery.time_value' | t }}</dd>
              </div>
              <div>
                <dt>{{ 'flexbrace.product.delivery.returns' | t }}</dt>
                <dd>{{ 'flexbrace.product.delivery.returns_value' | t }}</dd>
              </div>
              <div>
                <dt>{{ 'flexbrace.product.delivery.size' | t }}</dt>
                <dd>{{ 'flexbrace.product.delivery.size_value' | t }}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>

      {%- comment -%} FAQ {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-faq"
        aria-labelledby="fb-tab-faq"
        data-panel="faq"
        hidden
      >
        <div class="flexbrace-tabs-faq">
          <div class="flexbrace-tabs-faq__intro">
            <p class="product-page-eyebrow">{{ 'flexbrace.product.faq.eyebrow' | t }}</p>
            <h2>{{ 'flexbrace.product.faq.heading' | t }}</h2>
            <p>{{ 'flexbrace.product.faq.lead' | t }}</p>
          </div>
          <div class="flexbrace-tabs-faq__list">
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q1.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q1.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q2.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q2.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q3.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q3.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q4.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q4.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q5.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q5.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q6.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q6.answer' | t }}</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>{{ 'flexbrace.product.faq.q7.question' | t }}</summary>
              <p>{{ 'flexbrace.product.faq.q7.answer' | t }}</p>
            </details>
          </div>
        </div>
      </div>

      {%- comment -%} Om Flexbrace {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-about"
        aria-labelledby="fb-tab-about"
        data-panel="about"
        hidden
      >
        <div class="flexbrace-about" aria-label="{{ 'flexbrace.product.about.label' | t | escape }}">
          <div class="flexbrace-about__copy">
            <p class="flexbrace-about__eyebrow">{{ 'flexbrace.product.about.eyebrow' | t }}</p>
            <h2>{{ 'flexbrace.product.about.heading' | t }}</h2>
            <p>{{ 'flexbrace.product.about.body' | t }}</p>
            {%- capture about_url -%}{% render 'flexbrace-page-urls', which: 'about' %}{%- endcapture -%}
            <a class="flexbrace-about__link" href="{{ about_url | strip }}">{{ 'flexbrace.product.about.link' | t }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-flexbrace-tabs]');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));

    function activate(tabId, focusTab) {
      tabs.forEach(function (tab) {
        var selected = tab.getAttribute('data-tab') === tabId;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      });

      panels.forEach(function (panel) {
        var selected = panel.getAttribute('data-panel') === tabId;
        panel.classList.toggle('is-active', selected);
        if (selected) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-tab'), false);
      });

      tab.addEventListener('keydown', function (event) {
        var index = tabs.indexOf(tab);
        var next = index;

        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;

        event.preventDefault();
        activate(tabs[next].getAttribute('data-tab'), true);
      });
    });

  })();
</script>

{% schema %}
{
  "name": "Produktinfo flikar",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Bakgrundsfärg",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Bredd",
      "options": [
        { "value": "page-width", "label": "Sidbredd" },
        { "value": "full-width", "label": "Full bredd" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Topp",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Botten",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Produktinfo flikar"
    }
  ]
}
{% endschema %}
