{% comment %}
  Product info tabs — groups below-the-buy-box content into a horizontal tab menu.
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign fb = product
  if fb == blank
    assign fb = all_products['afo-ortos-ankel-fotortos']
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="flexbrace-tabs" data-flexbrace-tabs>
    <div class="flexbrace-tabs__nav-wrap">
      <div
        class="flexbrace-tabs__nav"
        role="tablist"
        aria-label="Produktinformation"
      >
        <button
          type="button"
          class="flexbrace-tabs__tab is-active"
          role="tab"
          id="fb-tab-overview"
          aria-selected="true"
          aria-controls="fb-panel-overview"
          data-tab="overview"
        >
          Översikt
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-specs"
          aria-selected="false"
          aria-controls="fb-panel-specs"
          data-tab="specs"
          tabindex="-1"
        >
          Specifikation
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-delivery"
          aria-selected="false"
          aria-controls="fb-panel-delivery"
          data-tab="delivery"
          tabindex="-1"
        >
          Leverans
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-faq"
          aria-selected="false"
          aria-controls="fb-panel-faq"
          data-tab="faq"
          tabindex="-1"
        >
          FAQ
        </button>
        <button
          type="button"
          class="flexbrace-tabs__tab"
          role="tab"
          id="fb-tab-about"
          aria-selected="false"
          aria-controls="fb-panel-about"
          data-tab="about"
          tabindex="-1"
        >
          Om Flexbrace
        </button>
      </div>
    </div>

    <div class="flexbrace-tabs__panels">
      {%- comment -%} Översikt {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel is-active"
        role="tabpanel"
        id="fb-panel-overview"
        aria-labelledby="fb-tab-overview"
        data-panel="overview"
      >
        <div class="flexbrace-product-section flexbrace-product-overview">
          <div class="flexbrace-product-section__header">
            <h2>Produktöversikt</h2>
            <p>
              Flexbrace® är en lätt och diskret droppfotsortos (ankel-fot-ortos) som är framtagen för dig som har svårt
              att lyfta foten under gång. När fotlyftet brister ökar risken att tårna fastnar i underlaget, att gången
              blir ojämn och att balansen påverkas. Flexbrace® ger ett kontrollerat lyft av framfoten, stabiliserar
              fotleden och stödjer ett mer naturligt gångmönster.
            </p>
          </div>

          <p class="flexbrace-product-overview__body">
            Produkten är utvecklad i Europa och bygger på mer än 30 års erfarenhet inom ortopedi och
            droppfotslösningar. Det gör Flexbrace® unik: en följsam skena utan onödig stelhet, med tillräckligt stöd
            för att lyfta och stabilisera – och en känsla som gör det enklare att använda skenan under längre stunder i
            vardagen.
          </p>

          <div class="flexbrace-product-overview__block">
            <h3>Vad Flexbrace® gör</h3>
            <p>
              Droppfot innebär ofta nedsatt förmåga att lyfta framfoten (dorsalflexion). Det kan göra att man lyfter
              benet högre än normalt, snubblar lättare och kompenserar med hela kroppen. Flexbrace® hjälper till att:
            </p>
            <ul class="flexbrace-checklist">
              <li>lyfta foten i svingfasen</li>
              <li>stabilisera fotleden</li>
              <li>förbättra gångmönstret mot en mer naturlig rörelse</li>
              <li>öka balansen och tryggheten i varje steg</li>
              <li>minska risken att tårna hakar i underlaget</li>
            </ul>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>Utformning och komfort</h3>
            <p>
              Flexbrace® är byggd för att synas så lite som möjligt och kännas så lätt som möjligt:
            </p>
            <ul class="flexbrace-checklist">
              <li>Låg vikt – cirka 100 gram</li>
              <li>Diskret passform som ofta går att använda i vanliga skor</li>
              <li>Hög komfort för dagligt bruk</li>
              <li>Följsam konstruktion som stödjer utan att “låsa” foten i onödan</li>
            </ul>
            <p class="flexbrace-product-overview__body">
              Målet är en skena du faktiskt vill ha på dig – inte bara en skena som fungerar i teorin.
            </p>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>Tillverkning</h3>
            <p>
              Designen och utformningen av Flexbrace® har tagits fram av experter inom ortopedi och hjälpmedel. Skenan
              tillverkas i högkvalitativ plast i Portugal, där produktionen sker med hög precision för jämn kvalitet i
              varje exemplar. Kombinationen av expertframtagen design och kontrollerad europeisk tillverkning ger en
              ortos som är både funktionell och hållbar att leva med.
            </p>
          </div>

          <div class="flexbrace-product-overview__block">
            <h3>För vem passar Flexbrace®?</h3>
            <p>
              Flexbrace® kan vara aktuell vid droppfot och nedsatt gångfunktion, till exempel i samband med
              nervpåverkan, neurologisk sjukdom eller andra tillstånd som påverkar fotlyft och fotledsstabilitet.
              Behovet ser olika ut från person till person; därför är individuell bedömning och rätt anpassning viktiga
              delar av en bra lösning.
            </p>
          </div>
        </div>
      </div>

      {%- comment -%} Specifikation {%- endcomment -%}      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-specs"
        aria-labelledby="fb-tab-specs"
        data-panel="specs"
        hidden
      >
        <div class="flexbrace-product-section flexbrace-product-section--surface">
          <div class="flexbrace-product-section__header">
            <p class="product-page-eyebrow">Produkt i fokus</p>
            <h2>Det du behöver veta</h2>
            <p>Lätt ortos med fokus på komfort och vardagsbruk.</p>
          </div>
          <div class="flexbrace-product-specs-grid">
            <div class="flexbrace-product-specs">
              <p class="flexbrace-product-specs__heading">Specifikation</p>
              <dl>
                <div>
                  <dt>Vikt</dt>
                  <dd>Ca 100 g</dd>
                </div>
                <div>
                  <dt>Produkttyp</dt>
                  <dd>Ankel-fotortos (AFO)</dd>
                </div>
                <div>
                  <dt>Komfort</dt>
                  <dd>Följsam, låg profil</dd>
                </div>
                <div>
                  <dt>Skor</dt>
                  <dd>Passar i vanliga skor</dd>
                </div>
                <div>
                  <dt>Variant</dt>
                  <dd>Höger eller vänster fot</dd>
                </div>
                <div>
                  <dt>Storlek</dt>
                  <dd>One size fits all (38–45)</dd>
                </div>
              </dl>
            </div>
            <div class="flexbrace-product-specs">
              <p class="flexbrace-product-specs__heading">Storleksguide</p>
              <dl>
                <div>
                  <dt>Passform</dt>
                  <dd>En storlek för hela spannet</dd>
                </div>
                <div>
                  <dt>EU</dt>
                  <dd>38–45</dd>
                </div>
                <div>
                  <dt>US herr</dt>
                  <dd>5.5–11.5</dd>
                </div>
                <div>
                  <dt>US dam</dt>
                  <dd>7.5–13</dd>
                </div>
                <div>
                  <dt>UK</dt>
                  <dd>5–10.5</dd>
                </div>
                <div>
                  <dt>CM</dt>
                  <dd>ca 24–29</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} Leverans {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-delivery"
        aria-labelledby="fb-tab-delivery"
        data-panel="delivery"
        hidden
      >
        <div class="flexbrace-product-section flexbrace-product-section--surface">
          <div class="flexbrace-product-section__header">
            <p class="product-page-eyebrow">Leverans &amp; retur</p>
            <h2>Så funkar frakt och öppet köp</h2>
            <p>Tydliga villkor innan du beställer – fri frakt inom EU och 90 dagars öppet köp.</p>
          </div>
          <div class="flexbrace-product-specs">
            <dl>
              <div>
                <dt>Frakt</dt>
                <dd>Fri frakt inom EU</dd>
              </div>
              <div>
                <dt>Leveranstid</dt>
                <dd>Aktuell leveranstid visas i kassan</dd>
              </div>
              <div>
                <dt>Öppet köp</dt>
                <dd>90 dagar – returnera enligt våra returvillkor om den inte passar</dd>
              </div>
              <div>
                <dt>Storlek</dt>
                <dd>One size fits all (38–45)</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>

      {%- comment -%} FAQ {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-faq"
        aria-labelledby="fb-tab-faq"
        data-panel="faq"
        hidden
      >
        <div class="flexbrace-tabs-faq">
          <div class="flexbrace-tabs-faq__intro">
            <p class="product-page-eyebrow">Vanliga frågor</p>
            <h2>Svar innan du beställer</h2>
            <p>Symptom, ortostyp, heldagsbruk, mått, retur, leverans och bidrag i Sverige.</p>
          </div>
          <div class="flexbrace-tabs-faq__list">
            <details class="flexbrace-tabs-faq__item">
              <summary>Vilka symptom passar Flexbrace för?</summary>
              <p>Flexbrace är tänkt för dig som har svårt att lyfta foten, snubblar, tippar i fotleden eller känner dig ostadig vid gång. Rådgör gärna med vårdgivare om du är osäker.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Vilken typ av ortos är Flexbrace?</summary>
              <p>En ankel-fot-ortos (AFO) som ger fotlyft och sidostöd. Lätt och lågprofilerad så den kan sitta inuti vanliga skor.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Kan jag använda den hela dagen?</summary>
              <p>Många använder Flexbrace under större delen av dagen. Börja stegvis och justera banden så stödet känns stabilt utan att klämma.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Hur fungerar storlek och mått?</summary>
              <p>Passformen bygger på mått eller utprovning och individuell anpassning. Välj rätt fotsida (höger/vänster) vid beställning.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Vad gäller för retur?</summary>
              <p>90 dagars öppet köp. Returnera enligt våra returvillkor om den inte passar.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Hur lång är leveranstiden?</summary>
              <p>Beror på anpassning och lagerläge. Aktuell tid visas i kassan. Fri frakt i Sverige.</p>
            </details>
            <details class="flexbrace-tabs-faq__item">
              <summary>Kan jag få bidrag eller hjälpmedel i Sverige?</summary>
              <p>Möjligheten till bidrag eller förskrivning varierar mellan regioner och din medicinska bedömning. Fråga din vårdgivare eller hjälpmedelscentral. Vi svarar på produktfrågor – men bedömer inte din rätt till bidrag.</p>
            </details>
          </div>
        </div>
      </div>

      {%- comment -%} Om Flexbrace {%- endcomment -%}
      <div
        class="flexbrace-tabs__panel"
        role="tabpanel"
        id="fb-panel-about"
        aria-labelledby="fb-tab-about"
        data-panel="about"
        hidden
      >
        <div class="flexbrace-about" aria-label="Om Flexbrace">
          <div class="flexbrace-about__copy">
            <p class="flexbrace-about__eyebrow">Erfarenhet</p>
            <h2>Individuella Flexbrace i över 25 år</h2>
            <p>
              Flexbrace bygger på lång bandageri-erfarenhet och individuella anpassningar. Bakom produkten finns ett team
              som hjälper dig med passform, frågor och nästa steg.
            </p>
            <a class="flexbrace-about__link" href="/pages/contact">Kontakta teamet</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-flexbrace-tabs]');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));

    function activate(tabId, focusTab) {
      tabs.forEach(function (tab) {
        var selected = tab.getAttribute('data-tab') === tabId;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focusTab) tab.focus();
      });

      panels.forEach(function (panel) {
        var selected = panel.getAttribute('data-panel') === tabId;
        panel.classList.toggle('is-active', selected);
        if (selected) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-tab'), false);
      });

      tab.addEventListener('keydown', function (event) {
        var index = tabs.indexOf(tab);
        var next = index;

        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;

        event.preventDefault();
        activate(tabs[next].getAttribute('data-tab'), true);
      });
    });

  })();
</script>

{% schema %}
{
  "name": "Produktinfo flikar",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Bakgrundsfärg",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Bredd",
      "options": [
        { "value": "page-width", "label": "Sidbredd" },
        { "value": "full-width", "label": "Full bredd" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Topp",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Botten",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Produktinfo flikar"
    }
  ]
}
{% endschema %}
