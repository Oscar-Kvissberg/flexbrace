{% comment %}
  Full-bleed about hero — Intuitive-style centered title over photo.
{% endcomment %}

{% liquid
  assign hero_heading = section.settings.heading | default: 'Om Flexbrace'
  assign hero_text = section.settings.text
  assign overlay_opacity = section.settings.overlay_opacity | default: 30 | divided_by: 100.0
  assign show_about_hero = false
  if page.handle == 'om-oss' or page.handle == 'about' or template.suffix == 'about'
    assign show_about_hero = true
  endif
%}

{% if show_about_hero %}
<section
  class="flexbrace-about-hero"
  style="--fb-about-hero-overlay: {{ overlay_opacity }}; --fb-about-hero-min-height: {{ section.settings.min_height }}vh;"
  aria-label="{{ hero_heading | escape }}"
>
  <div class="flexbrace-about-hero__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {% assign hero_alt = section.settings.image.alt | default: hero_heading %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'flexbrace-about-hero__img',
          alt: hero_alt
      }}
    {% else %}
      <img
        class="flexbrace-about-hero__img"
        src="{{ 'om-oss-hero.jpg' | asset_url }}"
        alt="{{ hero_heading | escape }}"
        width="2000"
        height="1333"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>

  <div class="flexbrace-about-hero__overlay" aria-hidden="true"></div>

  <div class="flexbrace-about-hero__content">
    <h1 class="flexbrace-about-hero__title">
      {{ hero_heading | escape }}<sup>®</sup>
    </h1>
    {% if hero_text != blank %}
      <p class="flexbrace-about-hero__text">{{ hero_text | escape }}</p>
    {% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Om oss hero",
  "tag": "section",
  "class": "flexbrace-about-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bakgrundsbild"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Om Flexbrace"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Ingress",
      "default": "Mer än 30 års erfarenhet inom ortopedi och droppfotslösningar."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay",
      "min": 20,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Höjd",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Om oss hero"
    }
  ]
}
{% endschema %}
