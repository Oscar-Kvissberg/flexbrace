{% comment %}
  Experience card — text left, image right.
{% endcomment %}

{% liquid
  assign eyebrow = section.settings.eyebrow | default: 'Erfarenhet'
  assign heading = section.settings.heading | default: 'Flexbrace® sedan 2001'
  assign body = section.settings.body
  assign link_label = section.settings.link_label | default: 'Läs mer om oss'
  assign link_url = section.settings.link_url | default: '/pages/om-oss'
%}

<div
  class="section-background"
  style="{% if section.settings.background_color != blank %}background: {{ section.settings.background_color }};{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="flexbrace-about" aria-label="{{ heading | escape }}">
    <div class="flexbrace-about__copy">
      {% if eyebrow != blank %}
        <p class="flexbrace-about__eyebrow">{{ eyebrow | escape }}</p>
      {% endif %}
      {% if heading != blank %}
        <h2>{{ heading | escape }}</h2>
      {% endif %}
      {% if body != blank %}
        <p>{{ body | escape }}</p>
      {% endif %}
      {% if link_label != blank %}
        <a class="flexbrace-about__link" href="{{ link_url }}">{{ link_label | escape }}</a>
      {% endif %}
    </div>

    <div class="flexbrace-about__media">
      {% if section.settings.image != blank %}
        {% assign image_alt = section.settings.image.alt | default: heading %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 750px) 544px, 100vw',
            class: 'flexbrace-about__img',
            alt: image_alt
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'flexbrace-about__img flexbrace-about__img--placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Om / erfarenhet",
  "tag": "section",
  "class": "flexbrace-about-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etikett",
      "default": "Erfarenhet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Flexbrace® sedan 2001"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text",
      "default": "Utvecklad av en auktoriserad bandagist med över 50 års erfarenhet inom ortopedteknik. Flexbrace® har hjälpt användare sedan 2001."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Länktext",
      "default": "Läs mer om oss"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Länk"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild till höger"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bakgrund",
      "default": "#f2f8fa"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Bredd",
      "options": [
        { "value": "page-width", "label": "Sidbredd" },
        { "value": "full-width", "label": "Fullbredd" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Överst",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Nederst",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Om / erfarenhet",
      "category": "Flexbrace"
    }
  ]
}
{% endschema %}
