{% comment %}
  About page body content for /pages/about
{% endcomment %}

{% liquid
  assign show_about = false
  if page.handle == 'om-oss' or page.handle == 'about' or template.suffix == 'about'
    assign show_about = true
  endif
%}

{% if show_about %}
  <div class="flexbrace-about-page">
    <div class="flexbrace-about-page__inner">
      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.who.heading' | t }}</h2>
        <p>{{ 'flexbrace.about.who.p1' | t }}</p>
        <p>{{ 'flexbrace.about.who.p2' | t }}</p>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.history.heading' | t }}</h2>
        <p>{{ 'flexbrace.about.history.p1' | t }}</p>
        <p>{{ 'flexbrace.about.history.p2' | t }}</p>
        <p>{{ 'flexbrace.about.history.p3' | t }}</p>
        <p>{{ 'flexbrace.about.history.p4' | t }}</p>
        <p>{{ 'flexbrace.about.history.p5' | t }}</p>
        <p>{{ 'flexbrace.about.history.p6' | t }}</p>
        <p>{{ 'flexbrace.about.history.p7' | t }}</p>
        <p>{{ 'flexbrace.about.history.p8' | t }}</p>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.vision_mission_heading' | t }}</h2>
        <p>
          <strong>{{ 'flexbrace.about.vision_label' | t }}</strong> {{ 'flexbrace.about.vision' | t }}
        </p>
        <p>
          <strong>{{ 'flexbrace.about.mission_label' | t }}</strong> {{ 'flexbrace.about.mission' | t }}
        </p>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.what.heading' | t }}</h2>
        <p>{{ 'flexbrace.about.what.p1' | t }}</p>
        <p>{{ 'flexbrace.about.what.p2' | t }}</p>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.values.heading' | t }}</h2>
        <ul class="flexbrace-checklist">
          <li>{{ 'flexbrace.about.values.1' | t }}</li>
          <li>{{ 'flexbrace.about.values.2' | t }}</li>
          <li>{{ 'flexbrace.about.values.3' | t }}</li>
          <li>{{ 'flexbrace.about.values.4' | t }}</li>
          <li>{{ 'flexbrace.about.values.5' | t }}</li>
        </ul>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.team.heading' | t }}</h2>
        <div class="flexbrace-about-page__person">
          <h3>{{ 'flexbrace.about.team.lars_name' | t }}</h3>
          <p>{{ 'flexbrace.about.team.lars_bio' | t }}</p>
        </div>
        <p class="flexbrace-about-page__note">{{ 'flexbrace.about.team.note' | t }}</p>
      </section>

      <section class="flexbrace-about-page__block">
        <h2>{{ 'flexbrace.about.competence.heading' | t }}</h2>
        <ul class="flexbrace-checklist">
          <li>{{ 'flexbrace.about.competence.1' | t }}</li>
          <li>{{ 'flexbrace.about.competence.2' | t }}</li>
          <li>{{ 'flexbrace.about.competence.3' | t }}</li>
          <li>{{ 'flexbrace.about.competence.4' | t }}</li>
          <li>{{ 'flexbrace.about.competence.5' | t }}</li>
        </ul>
      </section>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Om oss innehåll",
  "tag": "section",
  "class": "flexbrace-about-page-section",
  "settings": [],
  "presets": [
    {
      "name": "Om oss innehåll"
    }
  ]
}
{% endschema %}
