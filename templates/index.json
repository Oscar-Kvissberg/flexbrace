                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "s2_text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Flexbrace är en ankel-fot-ortos (AFO) som ger fotlyft och sidostöd. Den är lätt och lågprofilerad så den kan sitta inuti vanliga skor.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
